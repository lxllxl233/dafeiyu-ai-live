# 录像与备份：体积大，不入库（分 P 索引表除外，方便看每局录像）
recordings/*
!recordings/INDEX.md
backups/

# 运行期产物
__pycache__/
*.pyc
logs/*.jsonl
logs/.state_cache.json
logs/current_session.json
logs/route_plan.json

# 截图/预览（本地验收用）
preview*.png
preview*.jpg
*.mp4

# 打包产物（由 .dsh/skills 生成，避免双份）
dist/

# 临时文件
tmp_*.txt
tmp_*.py
tmp_*.json
tmp_*.png
tmp_*.wav

# 本地调试产物（截图/JSON 转储），不入库
logs/*.png
logs/*.json
logs/*.txt
logs/*.js
logs/*.log
logs/tts_cache/
*.wav
tmp_*.txt
tmp_*.json
tmp_*.py
tmp_notes*.md
logs/*.out
logs/*.err
