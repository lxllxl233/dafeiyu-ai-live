{
  "schema": 2,
  "id": "bilibili-hot-commentary",
  "version": "0.2.0",
  "name": "B站热门视频云观影",
  "name_en": "Bilibili Hot Video Commentary",
  "status": "mode",
  "platform": "B站 · 热门视频（只读元数据 + 弹幕时间轴）",
  "aliases": ["bili-hot", "bili-commentary", "bili-watch"],
  "entry": "plugin.py:BiliHotPlugin",
  "adapter": "adapter.py:BiliHotAdapter",
  "capabilities": {
    "observe": true,
    "control": false,
    "autoplay": true,
    "replay": false,
    "commentary": true,
    "modes": ["live", "llm"],
    "state_schema": "bili.commentary.state/v1",
    "action_schema": ""
  },
  "tags": ["云观影", "B站", "解说", "非游戏"],
  "notes": "按 B 包独立人设（默认参考 xQc）搜索/筛选视频，只读取标题/简介/UP 主/热评/弹幕时间轴；选中后用 Chrome 新窗口（默认副屏）打开视频页，可选自动点赞；每条视频开场/收尾各有一句问候，运行时桌宠/控制台空闲文案显示「看视频ing」；控制台游戏页可看播放列表、指定播放/关闭/刷新标签页，并可编辑 B 站专属人设；直播弹幕按频次/预算回复并优先 SC；不读取页面、不下载、不同步播放。",
  "commentary": {
    "speed": 1.0,
    "min_duration_s": 120,
    "max_duration_s": 1800,
    "min_comments": 12,
    "target_comments": 30,
    "min_like_view_ratio": 0.005,
    "max_danmaku_per_video": 10000,
    "max_candidates_per_cycle": 3,
    "seen_ttl_days": 7,
    "failed_cooldown_min": 30,
    "skip_cooldown_min": 60,
    "min_gap_s": 45,
    "max_cues": 8,
    "max_replies": 4,
    "reply_min_gap_s": 60,
    "dynamic_reactions": false,
    "prewarm_tts": true,
    "allow_multi_part": false,
    "search_enabled": true,
    "search_keywords": [],
    "search_exclude": ["杀戮尖塔", "尖塔", "Slay the Spire", "slay the spire"],
    "search_prefetch": 8,
    "search_limit": 20,
    "open_browser": true,
    "browser_path": "",
    "browser_window": true,
    "browser_monitor": "secondary",
    "like_on_watch": true,
    "live_chat_enabled": true,
    "live_reply_min_interval_s": 20,
    "live_reply_sc_min_interval_s": 5,
    "live_reply_max_per_min": 3,
    "live_reply_user_cooldown_s": 60,
    "live_reply_max_queue": 6,
    "live_reply_max_input_chars": 180,
    "live_reply_max_chars": 60,
    "live_reply_danmu_chars": 20,
    "live_reply_max_tokens_per_hour": 5000,
    "live_reply_max_tokens_per_day": 20000,
    "live_reply_send_danmu": true,
    "live_reply_speak": true,
    "exclude_keywords": [
      "政治", "选举", "灾难", "空难", "血腥", "自杀", "赌博", "医疗建议",
      "恐怖袭击", "枪击", "战争"
    ]
  }
}
